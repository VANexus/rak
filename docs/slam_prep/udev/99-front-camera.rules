# Front mono camera: ARC / AX USB2.0, USB ID 05a3:9230.
#
# Why this exists: with the Gemini 335L connected, UVC enumeration puts Gemini on
# /dev/video0-7 and this camera on /dev/video8 (metadata on /dev/video9). The
# default `video_device:=/dev/video0` in camera.launch.py then opens the Gemini
# depth node instead of the front camera.
#
# Install on the Jetson:
#   sudo cp 99-front-camera.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=video4linux --action=change
# Then use:
#   video_device:=/dev/front_camera
#
# index 0 selects the capture node, not the UVC metadata node.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="05a3", ATTRS{idProduct}=="9230", ATTR{index}=="0", SYMLINK+="front_camera", MODE:="0666", GROUP:="video"
