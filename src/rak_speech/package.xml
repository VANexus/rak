<?xml version="1.0"?>
<package format="3">
  <name>rak_speech</name>
  <version>0.1.0</version>
  <description>Offline speech recognition: audio -> transcript -> deterministic task intent.</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rak_intent</exec_depend>
  <!-- ADR-0020：managed 基类（ManagedNode）+ 生命周期转移返回值 -->
  <exec_depend>rak_lifecycle</exec_depend>
  <!-- 受管节点的周期性健康上报（/diagnostics） -->
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-vosk</exec_depend>
  <!-- source:=topic input: audio_capture publishes AudioData (audio_common). -->
  <exec_depend>audio_common_msgs</exec_depend>
  <!-- vtn_node / tts_node: WakeEvent + Say 契约(ADR-0013 冻结消息)。 -->
  <exec_depend>rak_interfaces</exec_depend>
  <!-- wake_doa_viz: WakeEvent.angle -> RViz arrow (visualization layer, sensors.launch). -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <!-- speaker_node: /audio -> /speech/speaker (3D-Speaker CAM++, 在线聚类,
       无注册档案; sherpa-onnx pip 包无 rosdep 键;模型在 acoustic/models/ 不进 git)。 -->
  <!-- tts_node: float32 PCM → S16 转换。sherpa-onnx 为 pip 安装,无 rosdep 键,
       缺失时 tts_node 降级(见 docs/microphone_array.md)。 -->
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
