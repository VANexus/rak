<?xml version="1.0"?>
<!-- Simulation fixture only. Dimensions, masses and limits are invented test values. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rak_six_axis_sim">
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.09" length="0.08"/></geometry>
      <origin xyz="0 0 0.04"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.09" length="0.08"/></geometry>
      <origin xyz="0 0 0.04"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <link name="shoulder_link">
    <visual><geometry><box size="0.08 0.08 0.08"/></geometry></visual>
    <collision><geometry><box size="0.08 0.08 0.08"/></geometry></collision>
    <inertial>
      <mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="j1_base" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="1.0"/>
  </joint>

  <link name="upper_arm_link">
    <visual><origin xyz="0.09 0 0"/><geometry><box size="0.18 0.035 0.035"/></geometry></visual>
    <collision><origin xyz="0.09 0 0"/><geometry><box size="0.18 0.035 0.035"/></geometry></collision>
    <inertial>
      <mass value="0.3"/><origin xyz="0.09 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="j2_shoulder" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1.0"/>
  </joint>

  <link name="forearm_link">
    <visual><origin xyz="0.08 0 0"/><geometry><box size="0.16 0.03 0.03"/></geometry></visual>
    <collision><origin xyz="0.08 0 0"/><geometry><box size="0.16 0.03 0.03"/></geometry></collision>
    <inertial>
      <mass value="0.25"/><origin xyz="0.08 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="j3_elbow" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0.18 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="4" velocity="1.2"/>
  </joint>

  <link name="wrist_yaw_link">
    <visual><geometry><sphere radius="0.035"/></geometry></visual>
    <collision><geometry><sphere radius="0.035"/></geometry></collision>
    <inertial>
      <mass value="0.12"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="j4_forearm" type="revolute">
    <parent link="forearm_link"/><child link="wrist_yaw_link"/>
    <origin xyz="0.16 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="2" velocity="1.5"/>
  </joint>

  <link name="wrist_pitch_link">
    <visual><geometry><sphere radius="0.03"/></geometry></visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="j5_wrist_pitch" type="revolute">
    <parent link="wrist_yaw_link"/><child link="wrist_pitch_link"/>
    <origin xyz="0.04 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="2" velocity="1.5"/>
  </joint>

  <link name="tool0">
    <visual><origin xyz="0.025 0 0"/><geometry><box size="0.05 0.05 0.05"/></geometry></visual>
    <collision><origin xyz="0.025 0 0"/><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <inertial>
      <mass value="0.08"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="j6_wrist_roll" type="revolute">
    <parent link="wrist_pitch_link"/><child link="tool0"/>
    <origin xyz="0.04 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="2.0"/>
  </joint>

  <link name="gripper_link">
    <visual><origin xyz="0 0.025 0"/><geometry><box size="0.06 0.01 0.02"/></geometry></visual>
    <collision><origin xyz="0 0.025 0"/><geometry><box size="0.06 0.01 0.02"/></geometry></collision>
    <inertial>
      <mass value="0.04"/><inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="gripper_joint" type="prismatic">
    <parent link="tool0"/><child link="gripper_link"/>
    <origin xyz="0.05 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.05" effort="1" velocity="0.05"/>
  </joint>
</robot>
