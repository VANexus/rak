<?xml version="1.0"?>
<!--
  rak_arm.urdf.xacro — 真实六轴机械臂（车顶安装）。
  [AI] 2026-10-08，与 six_axis_sim.urdf.xacro 完全隔离（fixture 是测试几何，不是本臂）。

  构型（用户确认 + TUI 实测标定，详见 properties_arm.xacro 头注）：
    J1 腰旋转(Z) → J2 大臂俯仰(+Y) → J3 肘俯仰(−Y，反向) → J4 小臂自旋(Z)
    → J5 腕俯仰(+Y，与 J2 同向) → J6 腕旋转(Z) → tool0
  几何约束（用户 2026-10-08 实测确认）：零位姿态下三个俯仰轴同轴共线
  （均垂直于臂轴、彼此平行），各俯仰舵机绕自身中位 ±90°；三个自旋轴共线。
  J3 俯仰方向与 J2/J5 相反。
  零位（q_urdf=0，用户指定）对应固件指令：
    J1=0°  J2=135°  J3=180°  J4=0°  J5=0°  J6=0°
  指令角 ↔ URDF 角：q_urdf = 指令_deg − 零位指令_deg。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rak">

  <xacro:include filename="properties_arm.xacro"/>
  <xacro:include filename="macros/inertial_macros.xacro"/>
  <xacro:include filename="macros/materials.xacro"/>
  <xacro:include filename="macros/arm_chain.xacro"/>

  <!-- [AI] 2026-10-15：臂的几何（7 link + 6 joint）已抽到
       macros/arm_chain.xacro —— 与 rak_chassis.urdf.xacro **共用同一份**，
       免得两棵树各写一份、改了一边忘了另一边。
       颜色也一并搬到 macros/materials.xacro。
       本文件的 name="rak" 与下面的 <ros2_control> 段**一个字都没动**。 -->
  <xacro:rak_arm_chain/>

  <!-- ============ 仿真用 ros2_control 硬件（纯软件层） ============
       [AI] 用 ros2_control 自带的 mock_components/GenericSystem：它是官方给
       "没有真实硬件、但要跑通 control 链路"用的组件 —— 命令写进去，状态跟着回来
       （默认状态=命令，JTC 在中间做时间插值，所以动作是平滑的）。
       关节名用 j1_base 系（= docs/arm_moveit_contract.md §1 FROZEN，与真机同名同域）。
       本段仍然只服务仿真（硬件插件是 mock_components），永远不接 F407。
       加这一段不影响 MoveIt/规划：<ros2_control> 没有 axis/limit，
       validate_rak_arm.py 会跳过它。 -->
  <ros2_control name="rak_arm_sim" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="j1_base">
      <command_interface name="position">
        <param name="min">${j1_lower}</param>
        <param name="max">${j1_upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="j2_shoulder">
      <command_interface name="position">
        <param name="min">${j2_lower}</param>
        <param name="max">${j2_upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">3.9269908</param>
      </state_interface>
    </joint>
    <joint name="j3_elbow">
      <command_interface name="position">
        <param name="min">${j3_lower}</param>
        <param name="max">${j3_upper}</param>
      </command_interface>
      <state_interface name="position">
        <!-- [AI] Home 位 J3 = 270° 正好压在**上限**上。270° = 4.71238898038…，
             原先写 4.7123890 比上限大 2e-8，被 controller_manager 判为
             "Command of at least one joint is out of limits (j3_elbow)"，
             **每秒刷一条 ERROR**。这里取上限的截断值（向下），别用四舍五入。 -->
        <param name="initial_value">4.7123889</param>
      </state_interface>
    </joint>
    <joint name="j4_forearm">
      <command_interface name="position">
        <param name="min">${j4_lower}</param>
        <param name="max">${j4_upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="j5_wrist_pitch">
      <command_interface name="position">
        <param name="min">${j5_lower}</param>
        <param name="max">${j5_upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="j6_wrist_roll">
      <command_interface name="position">
        <param name="min">${j6_lower}</param>
        <param name="max">${j6_upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>
</robot>
