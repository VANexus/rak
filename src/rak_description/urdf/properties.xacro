<?xml version="1.0"?>
<!--
  properties.xacro - NOTE: intentionally NO <xacro:property> definitions here.
  Spec section 7.3: properties live as <xacro:property> tags directly in the
  top-level URDF file so CLI overrides (link_length:=0.40) reach the link
  definitions. This file is kept as a documented future-proofing slot:
  shared properties can be moved here later via the standard xacro pattern,
  but doing so would break CLI override of those properties. (Ruling R4.1.)

  Joint ranges: kept here as named macros instead of properties, so a future
  setter that wants to override them does NOT need to redefine the macro;
  CLI override of a <xacro:macro> body is not how xacro works.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============== joint range limit macros ============== -->
  <xacro:macro name="shoulder_pitch_lower_value"><xacro:property name="v" value="${-pi/2}"/>${v}</xacro:macro>
  <xacro:macro name="shoulder_pitch_upper_value"><xacro:property name="v" value="${ pi/2}"/>${v}</xacro:macro>
  <xacro:macro name="elbow_pitch_lower_value"><xacro:property name="v" value="${-3*pi/4}"/>${v}</xacro:macro>
  <xacro:macro name="elbow_pitch_upper_value"><xacro:property name="v" value="${ 3*pi/4}"/>${v}</xacro:macro>
  <xacro:macro name="wrist_pitch_lower_value"><xacro:property name="v" value="${-pi/2}"/>${v}</xacro:macro>
  <xacro:macro name="wrist_pitch_upper_value"><xacro:property name="v" value="${ pi/2}"/>${v}</xacro:macro>

</robot>