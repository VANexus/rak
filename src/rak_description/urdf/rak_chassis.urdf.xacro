<?xml version="1.0"?>
<!-- [AI] 全机静态骨架 URDF：底盘几何 + 传感器安装帧 + **机械臂的真实运动链**。
     承载“静态坐标系”（fixed joints）、四轮连续关节，以及臂的 6 个旋转关节。

     [AI] 2026-10-15：机械臂的真实几何**已并入本文件**。几何本体单点定义在
     macros/arm_chain.xacro 的 <xacro:rak_arm_chain/> 宏里，由本文件与
     rak_arm.urdf.xacro **共用同一个宏** —— 不存在两份需要手工同步的副本。
     并入的理由：robot_state_publisher 只发本文件的 TF，而任何消费者（RViz、
     MoveIt、外部工具）要看到机械臂，就必须有 shoulder_link…tool0 这些帧；
     2026-10-15 之前这里是一条零长度桩链，发不出它们，真机的臂在 RViz 里是隐形的。
     <ros2_control> 里的 7 轴臂**位置接口**在本文件（2026-10-14 落地，
     ADR-0012 待闭合项 #1；名称/行程见 docs/arm_moveit_contract.md §1）。
     夹爪（第 7 路）**没有真实几何** —— 真实臂链止于 tool0（ADR-0008），本文件只在
     tool0 之后补一个无几何的 gripper_link 帧，因为 component_parser 要求
     <ros2_control> 的每个关节都存在于运动学树。
     该文件是 robot_state_publisher 的唯一静态几何来源。

     坐标系约定 (REP-103)：X 前，Y 左，Z 上。
     REP-120：base_footprint 在地面 (z=0) 作导航参考，base_link 为车体中心（轮系几何中心）。
     车体几何（2026-10-14 实测，量法=外廓−已知尺寸）：轴距 24.5 cm（前后轮最外点
     30 cm − 轮径 5.5 cm）；轮距 27.5 cm（左右轮最外侧面 30 cm − 轮宽 2.5 cm）。
     装载（2026-10-14 实测，全在纵中轴线上）：雷达扫描平面离地 18 cm、麦克风板中心
     离地 16 cm、深度相机光心离地 10 cm（车头最前 x=+15）、IMU 板中心离地 7 cm、
     机械臂安装面离地 10 cm（车尾最后 x=-15）。
     下方 z 均已按“离地值 − base_height”换算为相对 base_link 的值。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rak_chassis">

  <!-- [AI] 机械臂几何的唯一来源（见 macros/arm_chain.xacro 头注）。
       前三个是 <xacro:rak_arm_chain/> 宏体的依赖，必须在**调用之前**就位；
       宏内刻意不 include，因为 <material> 在同一棵树里重复会产生 urdfdom
       "not unique" 报错。 -->
  <xacro:include filename="properties_arm.xacro"/>
  <xacro:include filename="macros/inertial_macros.xacro"/>
  <xacro:include filename="macros/materials.xacro"/>
  <xacro:include filename="macros/arm_chain.xacro"/>

  <xacro:arg name="allow_motion" default="false"/>
  <!-- [AI] 从站裁剪（与 chassis_bringup 的 slaves:= 同义）：单板联调时把缺席那台的
       <ros2_control> 段整段去掉。不裁的话 controller_manager 仍会激活它，而它永远
       收不到反馈 → read() ERROR → CM 把硬件连同 joint_state_broadcaster 一起停用。 -->
  <xacro:arg name="slaves" default="both"/>
  <!-- [AI] 每轮极性（顺序 FL FR RL RR，经 launch 的 wheel_sign 单参数拆开）：
       +1 正常，-1 表示该轮命令与反馈同时取反。
       物理方向的唯一权威在固件 vehical_rak_motion/Core/Inc/wheel_config.h
       （wheel_forward_dir / wheel_encoder_dir）。2026-11-16/17 目视+线级实测：
       指令全 +1 时车直着往前走，Jetson 不叠加第二份命令符号，四默认值统一 +1；
       2026-10-14“左侧 FL/RL 取反”的旧结论作废。
       反馈侧同理：固件 car_wheel_positions() 已乘 encoder_sign（真值
       [-1,+1,+1,-1]，Flash seq=1 实测保持），OD 0x2020.. 出来即"正指令→正
       counts"，主机 state_sign 必须保持 1（2026-11-18 悬空实测四轮增量全正，
       旧的 -1 会再翻一次，直走被里程计算成自转）。
       换轮/重接线后重新标定改 wheel_config.h（或 launch wheel_sign:=）。 -->
  <xacro:arg name="wheel_sign_fl" default="1"/>
  <xacro:arg name="wheel_sign_fr" default="1"/>
  <xacro:arg name="wheel_sign_rl" default="1"/>
  <xacro:arg name="wheel_sign_rr" default="1"/>
  <!-- [AI] REP-120: base_link(轮轴心面)离地高度。2026-10-14 实测轮径 5.5 cm，
       轴心离地 = 轮半径 = 0.0275（轮关节在 base_link z=0，轮必须接地） -->
  <xacro:arg name="base_height" default="0.0275"/>
  <!-- [AI] 雷达扫描平面 base_link→laser_link 高度。2026-10-14 实测扫描平面离地
       0.18（确认为出光面，非壳顶）− base_height 0.0275 = 0.1525 -->
  <xacro:arg name="lidar_z" default="0.1525"/>
  <!-- [AI] 雷达安装偏航（REP-103：+z 朝上，向左 = +yaw）。
       2026-11-17 重标：旧值 0.9460 rad（54.2°）**错了 90°**，已作废。
       证据（两路独立传感器互证）：
       - 激光系 0..80° 有一段长直墙，垂直距离 1.02 m（RANSAC 162 点 / 4.10 m）；
       - Gemini335L 深度图（424×240, fx=211.9）整幅 0.87 m 均匀、±42° 全覆盖，
         且 0.87 + cam_x 0.15 ≈ 1.02 → 同一面墙；
       - 该墙在激光系方位 ≈37.6°，要落到车头（base_link +x）需 yaw = −37.6°；
         此时其余主墙法向恰为 90/180/270（残差 ≲2°）。
       反证：若仍取 54.2°，这面墙落到 base 54..134°（车左），深度相机 ±45° 视野
       根本看不到它、更不会算出 0.87 m —— 故 54.2 与相机结论互斥。
       物理含义：雷达相对车头又被(or 一直)转了 ≈90°。**动了雷达就重标这个数**：
       让它对准一面墙，令该墙在 /scan 上的激光方位 ≈ −(yaw)，即 base 0°。 -->
  <xacro:arg name="lidar_yaw" default="-0.6561"/>
  <!-- [AI] 2026-11-17 轮域陀螺稳定器（固件 R74，cmd_flags.bit1）。开着时板子用自己
       IMU 的 yaw rate 闭环修四轮目标 —— 直走"很歪"的第一手段。默认关：它是跑在
       MCU 里的内环，开之前先读 docs/CANOPEN-V5.md §5。用 launch 参数 A/B。 -->
  <xacro:arg name="stabilizer" default="false"/>

  <!-- ===== 车体几何（2026-10-11 实测）===== -->
  <xacro:property name="wheelbase" value="0.245"/>  <!-- 轴距：前后轮最外点 30 − 轮径 5.5（2026-10-14） -->
  <xacro:property name="track"     value="0.275"/>  <!-- 轮距：左右轮最外侧面 30 − 轮宽 2.5 = 27.5（2026-10-14；旧粗测 27） -->
  <xacro:property name="hw" value="${wheelbase/2}"/>  <!-- 半轴距 -->
  <xacro:property name="ht" value="${track/2}"/>      <!-- 半轮距 -->

  <!-- ===== 传感器/机械臂安装偏移（2026-10-14 实测；z = 离地值 − base_height 0.0275）===== -->
  <xacro:property name="laser_x" value="0.11"/>      <!-- 雷达 x：实测距轴中点 11 cm（前轴平面后 1.5 cm） -->
  <xacro:property name="mic_z"   value="0.1325"/>    <!-- 麦克风 z：板中心离地 0.16（雷达正上方，x 借 laser_x） -->
  <xacro:property name="cam_x"   value="0.15"/>      <!-- 相机 x：实测 0.15，车头最前 -->
  <xacro:property name="cam_z"   value="0.0725"/>    <!-- 相机 z：光心离地 0.10 -->
  <xacro:property name="imu_x"   value="0.08"/>      <!-- IMU x：实测 0.08 -->
  <xacro:property name="imu_z"   value="0.0425"/>    <!-- IMU z：板中心离地 0.07 -->
  <xacro:property name="arm_x"   value="-0.15"/>     <!-- 机械臂 x：实测车尾最后端 x=-0.15（与车头最前对称，全外廓 30 cm） -->
  <xacro:property name="arm_z"   value="0.0725"/>    <!-- 机械臂安装面 z：离地 0.10 -->

  <!-- ===== 地面投影 / 车体中心（REP-120 / REP-103）===== -->
  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <!-- 车体占位盒（长×宽×高）：TODO(measured) 实测外壳 -->
        <box size="${wheelbase} ${track} 0.08"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- base_footprint(地面) -> base_link(车体中心)：REP-120 固定竖直偏移 -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 $(arg base_height)" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="mecanum_wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <!-- 轮 2026-10-14 实测：径 Ø5.5 cm、厚 2.5 cm -->
          <cylinder radius="0.0275" length="0.025"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </visual>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0008"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- [AI] 轮位来自实测轮距/轴距；控制器运动学参数在 controllers.yaml -->
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- [AI] R37: velocity limit 供 CM JointSaturationLimiter 使用（占位值） -->
      <limit velocity="10" effort="10"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_left"  x="${hw}"  y="${ht}"/>
  <xacro:mecanum_wheel prefix="front_right" x="${hw}"  y="${-ht}"/>
  <xacro:mecanum_wheel prefix="rear_left"   x="${-hw}" y="${ht}"/>
  <xacro:mecanum_wheel prefix="rear_right"  x="${-hw}" y="${-ht}"/>

  <!-- ===== 传感器安装帧（fixed；几何单一来源，勿在 launch 里重复发布）===== -->
  <!-- 雷达：前·中轴，2026-10-17 起带 lidar_yaw 偏航补偿。scan 的 frame_id=laser_link（驱动默认，勿改） -->
  <link name="laser_link"/>
  <joint name="laser_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_x} 0 $(arg lidar_z)" rpy="0 0 $(arg lidar_yaw)"/>
  </joint>

  <!-- 6 阵列麦克风：雷达正上方（vtn_node 桥接，本身不发 TF）。x 实测 0.11 与雷达同 x，借 laser_x -->
  <link name="mic_array_link"/>
  <joint name="mic_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mic_array_link"/>
    <origin xyz="${laser_x} 0 ${mic_z}" rpy="0 0 0"/>
  </joint>

  <!-- 深度相机：车头最前。内参/光学帧(camera_*_optical_frame)由 Orbbec 驱动发布，
       此处只挂载安装帧 camera_link；base_link->camera_link 外参 TODO(measured) -->
  <link name="camera_link"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 0 0"/>
  </joint>

  <!-- IMU：LSM6DSRTR（I2C）。2026-10-26 模块改竖装（芯片 +Y 朝上），
       i2c_imu.py 的 axis_map='-z,-x,y' 已把数据重排成 REP-103
       （x 前 / y 左 / z 上），所以 imu_link 与 base_link **同向**，rpy=0。
       ⚠️ 2026-10-29 修正：原来是 SPI 时代的 pitch=-90°（那时 spi_imu.py
       原样发芯片轴，靠这个 TF 摆正）。驱动换 I2C 后自己摆正了，URDF 再转
       一次 = 把滚转当偏航。依据见 i2c_imu.py 头注释的实测表。 -->
  <link name="imu_link"/>
  <joint name="imu_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} 0 ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- 机械臂安装帧：后·中轴。姿态/安装面高度 TODO(measured)；
       六轴运动链在 macros/arm_chain.xacro（本文件与 rak_arm.urdf.xacro 共用同一宏；
       wbc_base.urdf.xacro 为分析镜像，值须同步） -->
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="${arm_x} 0 ${arm_z}" rpy="0 0 0"/>
  </joint>

  <!-- [AI] 机械臂的真实运动链（2026-10-15 并入，替换掉原来的零长度桩链）。
       宏会产出 arm_base_link（即上面 arm_mount_joint 的 child），所以本文件
       **不再**自己定义 <link name="arm_base_link"/> —— 同一棵树里定义两次会直接
       解析失败。宏同时产出 6 个关节，其 <limit> 直接引用 properties_arm.xacro 的
       ${jN_lower}/${jN_upper}（指令角域 0..270°、J2 0..255°），与 2026-10-15
       之前的桩链**数值完全相同**，所以 controller_manager 的有效限幅不变。 -->
  <xacro:rak_arm_chain/>

  <!-- [AI] 夹爪控制手柄（**非几何**）：真实臂链止于 tool0（ADR-0008 —— 夹爪不在这
       个模型里，支架也从未实测）。但本文件的 <ros2_control> 需要 gripper_joint 存在，
       而 Jazzy component_parser 对其中的每个 joint 都要在运动学树里 getJoint() 一次，
       查不到就抛 "Joint 'x' not found in URDF"、controller_manager 放弃初始化
       （症状是卡在 "Waiting for data on 'robot_description'"，很难查）。
       所以 tool0 之后接一个**无 visual/collision/inertial** 的帧 —— 这是刻意的：
       没有量过的几何就不画，免得像底座那条圆柱一样变成"看起来有依据"的假数据。
       为什么用 revolute 而不是 prismatic：物理通道是位置舵机（GRIP，指令角域
       0..270°）；prismatic 会凭空宣布一个"开度约 4.71 米"的伪造量程。
       ⚠️ [AI] 2026-10-16：本文件的臂关节已改成引用 ${jN_lower}/${jN_upper}，
       唯独这个夹爪是**字面量** —— 而且这里的 `<limit>` 与下方 <ros2_control> 里
       `gripper_joint` 的 command max 是**两个字面量，必须同值**
       （新加的 src/rak_chassis/test/validate_chassis_urdf.py 会断言二者相等；
        它们不等就意味着 import_joint_limiters 与 JointSaturationLimiter 打架）。
       刻意**不**引用 properties_arm.xacro：夹爪从未标定，把它塞进「臂标定单点」
       等于把没量过的东西混进实测数据。**改夹爪行程时两处一起改。** -->
  <link name="gripper_link"/>
  <joint name="gripper_joint" type="revolute">
    <parent link="tool0"/><child link="gripper_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="4.71239" effort="2.0" velocity="6.0"/>
  </joint>

  <!-- ==================== ros2_control：CANopen v5 薄桥 ====================
       协议归 ros2_canopen（主站 + proxy driver，apt 0.3.4）；本文件只声明
       "哪个关节 ↔ 哪个 OD 对象、怎么量化、要不要取反"。硬件插件不发 CAN 帧、
       不实现 CANopen：它订阅 `<driver_node>/rpdo`、发布 `<driver_node>/tpdo`
       （canopen_interfaces/msg/COData），由 ros2_canopen 负责 NMT/SYNC/PDO/SDO。

       两块 F407 = 两个 <ros2_control> = 两个故障域：一块板掉线只报该板 ERROR，
       不拖垮另一块（read() 的失败判据按 driver_node 隔离）。

       OD 对象索引/类型/量化因子的唯一来源是 `src/rak_canopen/config/*.json` +
       `canopen_contract.yaml`；本文件是它们的**消费方**，改协议先改那边。 -->
  <xacro:if value="${'$(arg slaves)' in ('both', 'chassis')}">
  <ros2_control name="rak_chassis" type="system">
    <hardware>
      <plugin>rak_chassis/CanopenChassis</plugin>
      <!-- 运动许可：默认 false=命令恒 0、cmd_flags.bit0=0；实驱必须显式 allow_motion:=true -->
      <param name="allow_motion">$(arg allow_motion)</param>
      <!-- proxy driver 的节点名（bus.yaml 顶层键）→ 话题 /chassis/rpdo、/chassis/tpdo -->
      <param name="driver_node">chassis</param>
      <param name="feedback_timeout_ms">200</param>
      <!-- 命令活性（[V5] §5）：cmd_seq 100 ms 内必须变化且 cmd_flags.bit0=1 -->
      <param name="cmd_seq_object">0x2040</param>
      <param name="cmd_flags_object">0x2041</param>
      <param name="enable_bit">0</param>
      <!-- 命令周期重发（ms）：事件驱动只在目标变化时发 RPDO1，丢一帧就停在旧值；
           按这个周期无条件重发一遍。0 = 关闭（回到纯事件驱动）。 -->
      <param name="command_refresh_ms">250</param>
      <!-- 速度反馈 = 轮位置差分：板上 0x2010..0x2013 会冻结在旧值（实测），
           0x2020..0x2023 的位置一路正确。里程计与闭环只信可靠的那路。 -->
      <param name="velocity_from_position">true</param>
      <!-- cmd_flags.bit1 = 轮域陀螺稳定器（见文件头 stabilizer 参数说明） -->
      <param name="stabilizer">$(arg stabilizer)</param>
    </hardware>
    <!-- 轮命令 0x2000..0x2003 INT16，0.01 rad/s（counts = rad/s × 100）；
         反馈 0x2010..0x2013 INT16，0.01 rad/s（rad/s = counts × 0.01）。
         W1..W4 = [FL, FR, RL, RR]，2026-10-30 实测轮序（CAN-BRINGUP §7.1）。 -->
    <joint name="front_left_wheel">
      <param name="command_object">0x2000</param>
      <param name="command_type">int16</param>
      <param name="command_scale">100.0</param>
      <param name="state_object">0x2010</param>
      <param name="state_type">int16</param>
      <param name="state_scale">0.01</param>
            <param name="sign">$(arg wheel_sign_fl)</param>
      <!-- [AI] 2026-11-17 轮位置反馈 0x2020 INT32 = 编码器计数（固件 wheel_config.h
           WHEEL_CPR_LIST = 61600 counts/rev）→ rad/count = 2π/61600 = 0.00010199976148018809。
           没有这一路时 joint_state_broadcaster 只能发 NaN 位置：车轮 TF 被
           robot_state_publisher 丢弃，mecanum 控制器也只能积分速度算里程计。 -->
      <!-- [AI] R80 2026-11-18 悬空实测纠正：反馈**不要**再乘 encoder_sign。
           固件 `car_wheel_positions()` 已经 `out[i] = position_counts[i] * sign`
           （app_car.c），OD 0x2020.. 出来的就是"正指令 → 正 counts"。
           实测：正向指令 1.5 s 四轴 OD 增量 FL=+582816 FR=+610134
           RL=+593716 RR=+583507 —— 全为正。旧值 −1 再翻一次，正是
           "直走被里程计算成自转"的根因。命令侧符号不动。 -->
      <param name="state_sign">1</param>
      <param name="aux_state_object">0x2020</param>
      <param name="aux_state_type">int32</param>
      <param name="aux_state_scale">0.00010199976148018809</param>
      <param name="aux_state_interface">position</param>
      <!-- 显式 min/max：CM 的 JointSaturationLimiter 在无界 [nan,nan] 下会产生 NaN 指令 -->
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_wheel">
      <param name="command_object">0x2001</param>
      <param name="command_type">int16</param>
      <param name="command_scale">100.0</param>
      <param name="state_object">0x2011</param>
      <param name="state_type">int16</param>
      <param name="state_scale">0.01</param>
            <param name="sign">$(arg wheel_sign_fr)</param>
      <!-- [AI] 2026-11-17 轮位置反馈 0x2021 INT32 = 编码器计数（固件 wheel_config.h
           WHEEL_CPR_LIST = 61600 counts/rev）→ rad/count = 2π/61600 = 0.00010199976148018809。
           没有这一路时 joint_state_broadcaster 只能发 NaN 位置：车轮 TF 被
           robot_state_publisher 丢弃，mecanum 控制器也只能积分速度算里程计。 -->
      <!-- 反馈符号 = 固件实测编码器极性 encoder_sign（SWD 读出，
           openocd 清 0 后 kick 自学得到）：[-1,+1,+1,-1]。
           这一路不快照固件就会让里程计把"直走"算成自转。命令侧符号不动。 -->
      <param name="state_sign">1</param>
      <param name="aux_state_object">0x2021</param>
      <param name="aux_state_type">int32</param>
      <param name="aux_state_scale">0.00010199976148018809</param>
      <param name="aux_state_interface">position</param>
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_wheel">
      <param name="command_object">0x2002</param>
      <param name="command_type">int16</param>
      <param name="command_scale">100.0</param>
      <param name="state_object">0x2012</param>
      <param name="state_type">int16</param>
      <param name="state_scale">0.01</param>
            <param name="sign">$(arg wheel_sign_rl)</param>
      <!-- [AI] 2026-11-17 轮位置反馈 0x2022 INT32 = 编码器计数（固件 wheel_config.h
           WHEEL_CPR_LIST = 61600 counts/rev）→ rad/count = 2π/61600 = 0.00010199976148018809。
           没有这一路时 joint_state_broadcaster 只能发 NaN 位置：车轮 TF 被
           robot_state_publisher 丢弃，mecanum 控制器也只能积分速度算里程计。 -->
      <!-- 反馈符号 = 固件实测编码器极性 encoder_sign（SWD 读出，
           openocd 清 0 后 kick 自学得到）：[-1,+1,+1,-1]。
           这一路不快照固件就会让里程计把"直走"算成自转。命令侧符号不动。 -->
      <param name="state_sign">1</param>
      <param name="aux_state_object">0x2022</param>
      <param name="aux_state_type">int32</param>
      <param name="aux_state_scale">0.00010199976148018809</param>
      <param name="aux_state_interface">position</param>
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_wheel">
      <param name="command_object">0x2003</param>
      <param name="command_type">int16</param>
      <param name="command_scale">100.0</param>
      <param name="state_object">0x2013</param>
      <param name="state_type">int16</param>
      <param name="state_scale">0.01</param>
            <param name="sign">$(arg wheel_sign_rr)</param>
      <!-- [AI] 2026-11-17 轮位置反馈 0x2023 INT32 = 编码器计数（固件 wheel_config.h
           WHEEL_CPR_LIST = 61600 counts/rev）→ rad/count = 2π/61600 = 0.00010199976148018809。
           没有这一路时 joint_state_broadcaster 只能发 NaN 位置：车轮 TF 被
           robot_state_publisher 丢弃，mecanum 控制器也只能积分速度算里程计。 -->
      <!-- [AI] R80 2026-11-18 悬空实测纠正：反馈**不要**再乘 encoder_sign。
           固件 `car_wheel_positions()` 已经 `out[i] = position_counts[i] * sign`
           （app_car.c），OD 0x2020.. 出来的就是"正指令 → 正 counts"。
           实测：正向指令 1.5 s 四轴 OD 增量 FL=+582816 FR=+610134
           RL=+593716 RR=+583507 —— 全为正。旧值 −1 再翻一次，正是
           "直走被里程计算成自转"的根因。命令侧符号不动。 -->
      <param name="state_sign">1</param>
      <param name="aux_state_object">0x2023</param>
      <param name="aux_state_type">int32</param>
      <param name="aux_state_scale">0.00010199976148018809</param>
      <param name="aux_state_interface">position</param>
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  </xacro:if>

  <!-- ==================== 机械臂段（ADR-0019） ====================
       臂板（vehical_rak_arm）自己的故障域，driver_node=arm（node 2）。
       命令 0x2100..0x2106 UINT16 0.1°；反馈 0x2110..0x2116，J1/J2 是 INT16、
       J3..J6 是 UINT16（A31 起 J1/J2 有符号化）。夹爪无物理反馈 → 不导出 state。
       名称/行程按 docs/arm_moveit_contract.md §1（FROZEN）：命令域是舵机指令角
       （rad，0..270°，Home=0/225/270/0/0/0），**不是** rak_arm.urdf.xacro 的 q_urdf。
       min/max 引用 properties_arm.xacro，与臂 <limit> 同一表达式。 -->
  <xacro:if value="${'$(arg slaves)' in ('both', 'arm')}">
  <ros2_control name="rak_arm" type="system">
    <hardware>
      <plugin>rak_chassis/CanopenArm</plugin>
      <param name="allow_motion">$(arg allow_motion)</param>
      <param name="driver_node">arm</param>
      <param name="feedback_timeout_ms">200</param>
      <param name="cmd_seq_object">0x2140</param>
      <param name="cmd_flags_object">0x2141</param>
      <param name="enable_bit">0</param>
      <!-- 臂板健康位（0x2131 fault，非 0 抑制臂命令） -->
      <param name="fault_object">0x2131</param>
    </hardware>
    <joint name="j1_base">
      <param name="command_object">0x2100</param>
      <param name="command_type">uint16</param>
      <param name="command_scale">572.9577951308232</param>
      <param name="state_object">0x2110</param>
      <param name="state_type">int16</param>
      <param name="state_scale">0.0017453292519943296</param>
      <command_interface name="position">
        <param name="min">${j1_lower}</param>
        <param name="max">${j1_upper}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="j2_shoulder">
      <param name="command_object">0x2101</param>
      <param name="command_type">uint16</param>
      <param name="command_scale">572.9577951308232</param>
      <param name="state_object">0x2111</param>
      <param name="state_type">int16</param>
      <param name="state_scale">0.0017453292519943296</param>
      <command_interface name="position">
        <param name="min">${j2_lower}</param>
        <param name="max">${j2_upper}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="j3_elbow">
      <param name="command_object">0x2102</param>
      <param name="command_type">uint16</param>
      <param name="command_scale">572.9577951308232</param>
      <param name="state_object">0x2112</param>
      <param name="state_type">uint16</param>
      <param name="state_scale">0.0017453292519943296</param>
      <command_interface name="position">
        <param name="min">${j3_lower}</param>
        <param name="max">${j3_upper}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="j4_forearm">
      <param name="command_object">0x2103</param>
      <param name="command_type">uint16</param>
      <param name="command_scale">572.9577951308232</param>
      <param name="state_object">0x2113</param>
      <param name="state_type">uint16</param>
      <param name="state_scale">0.0017453292519943296</param>
      <command_interface name="position">
        <param name="min">${j4_lower}</param>
        <param name="max">${j4_upper}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="j5_wrist_pitch">
      <param name="command_object">0x2104</param>
      <param name="command_type">uint16</param>
      <param name="command_scale">572.9577951308232</param>
      <param name="state_object">0x2114</param>
      <param name="state_type">uint16</param>
      <param name="state_scale">0.0017453292519943296</param>
      <command_interface name="position">
        <param name="min">${j5_lower}</param>
        <param name="max">${j5_upper}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="j6_wrist_roll">
      <param name="command_object">0x2105</param>
      <param name="command_type">uint16</param>
      <param name="command_scale">572.9577951308232</param>
      <param name="state_object">0x2115</param>
      <param name="state_type">uint16</param>
      <param name="state_scale">0.0017453292519943296</param>
      <command_interface name="position">
        <param name="min">${j6_lower}</param>
        <param name="max">${j6_upper}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <!-- 夹爪（第 7 路）：命令通道 0x2106 有，物理反馈没有（0x2116 按契约无效）
         —— 刻意不声明 state_interface，消费端只能显示命令值。 -->
    <joint name="gripper_joint">
      <param name="command_object">0x2106</param>
      <param name="command_type">uint16</param>
      <param name="command_scale">572.9577951308232</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">4.71239</param>
      </command_interface>
    </joint>
  </ros2_control>
  </xacro:if>
</robot>
