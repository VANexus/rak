<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_arm_tui</name>
  <version>0.1.0</version>
  <description>
    Terminal TUI for hand-teaching the six Rak arm servos over the USB v2
    link (ARM_COMMAND 6-axis urad positions). Commissioning tool only —
    not a production motion interface.
  </description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rak_base_driver</depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
