<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_bringup</name>
  <version>0.1.0</version>
  <description>Single robot-level composition layer: all launch files, params, udev and operator scripts (ADR-0013 absorbs rak_sensor_bringup, rak_navigation, rak_chassis_bringup).</description>
  <maintainer email="xrak@example.com">xrak</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- canopen_bringup.launch.py 引用 rak_canopen 的 bus/controllers 配置（ADR-0024） -->
  <exec_depend>rak_canopen</exec_depend>
  <!-- 组装契约层（清单 / 编排入口 / 档位），本包只负责硬件全栈组合（ADR-0026） -->
  <exec_depend>rak_orchestration</exec_depend>
  <!-- 传感器链（原 rak_sensor_bringup） -->
  <exec_depend>lslidar_driver</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>rak_astra_driver</exec_depend>
  <exec_depend>rak_stereo_driver</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <!-- sensors.launch.py: Jetson-direct SPI IMU + uniform depth point cloud -->
  <exec_depend>rak_imu_driver</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <!-- 导航链（原 rak_navigation） -->
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rak_motion_stub</exec_depend>
  <exec_depend>rak_lifecycle</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <!-- [AI] launch 直引用声明（check_workspace 门禁） -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- 底盘 ros2_control 链（原 rak_chassis_bringup） -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rak_description</exec_depend>
  <exec_depend>rak_chassis</exec_depend>
  <!-- 任务/决策/仿真 -->
  <exec_depend>rak_agent</exec_depend>
  <exec_depend>rak_task_executor</exec_depend>
  <!-- Jev↔executor 仲裁缝 + 语音对话环(ADR-0010) -->
  <exec_depend>rak_harness</exec_depend>
  <exec_depend>rak_tool_executor</exec_depend>
  <!-- 语音链:audio_common 采集阵列 → /audio → asr_node;vtn_node 唤醒桥;
       tts_node → /audio_out → audio_play 播报 -->
  <exec_depend>audio_capture</exec_depend>
  <exec_depend>audio_play</exec_depend>
  <exec_depend>rak_speech</exec_depend>
  <exec_depend>rak_moveit_config</exec_depend>
  <!-- 抓取相机合成（原在 rak_grasp_perception，重组后归组装层） -->
  <exec_depend>rak_grasp_perception</exec_depend>
  <exec_depend>rak_pointcloud</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- sensors_rviz.rviz: IMU display class -->
  <exec_depend>rviz_imu_plugin</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
