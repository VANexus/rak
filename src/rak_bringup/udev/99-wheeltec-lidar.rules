# WHEELTEC / Leishen N10_P lidar: stable device alias.
#
# The packaged lslidar config opens /dev/wheeltec_lidar. Without this rule that path
# does not exist and the driver fails with a bare "open_port ERROR", which reads like
# a hardware fault. lidar.launch.py falls back to /dev/serial/by-id when the alias is
# missing, but the alias is the documented setup -- install it:
#
#   sudo cp src/rak_bringup/udev/99-wheeltec-lidar.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# The N10_P's USB-UART bridge is a Silicon Labs CP2102 (10c4:ea60) whose serial
# number is the generic "0001", so the match is on VID:PID only. If another CP2102
# is ever added (the retired base adapter was one), this rule will name whichever
# enumerated first -- pin it by port path instead when that happens.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="wheeltec_lidar", MODE="0660", GROUP="dialout"
