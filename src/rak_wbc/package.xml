<?xml version="1.0"?>
<package format="3">
  <name>rak_wbc</name>
  <version>0.1.0</version>
  <description>Velocity-level whole-body arbitration (WBC/HQP) for the mecanum base + six-axis arm; single regular motion writer per ADR-0011.</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>rak_lifecycle</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- [AI] ADR-0011 待闭合 #6：pinocchio / osqp 的 rosdep 键与 aarch64 可得性待核实
       （桌面 x86 已实测 PyPI `pin` 4.1.0 + `osqp` 1.1.3 可跑）。
       核实前不在此声明，避免 rosdep 因未知键失败；节点启动时缺依赖会给出明确报错。 -->
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>