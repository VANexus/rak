<?xml version="1.0"?>
<package format="3">
  <name>rak_task_executor</name>
  <version>0.1.0</version>
  <description>Single owner for text navigation tasks and Nav2 interruption lifecycle.</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- launch/ 里的 task_simulation.launch.py 用得到，缺声明会让 rosdep/单独 clone 断链 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rak_interfaces</exec_depend>
  <exec_depend>rak_intent</exec_depend>
  <exec_depend>rak_lifecycle</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
