<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_chassis</name>
  <version>0.2.0</version>
  <description>Thin CANopen bridge: ros2_control hardware interfaces (4 wheel velocity / 7 axis position) mapped onto ros2_canopen proxy-driver OD objects. Owns no CAN frames and no protocol.</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>canopen_interfaces</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/rak_chassis_plugin.xml"/>
  </export>
</package>
