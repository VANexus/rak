<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_tool_executor</name>
  <version>0.1.0</version>
  <description>Single deterministic executor for the versioned tool-proposal contract (see docs/brain_arm_tools_design.md, DESIGN DRAFT).</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rak_interfaces</depend>
  <!-- ADR-0020: ManagedNode 基类 + 诊断上报 -->
  <depend>rak_lifecycle</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
