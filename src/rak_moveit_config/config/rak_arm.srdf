<?xml version="1.0"?>
<!--
  rak_arm.srdf — 真实六轴机械臂的语义模型（2026-10-08，2026-10-15 统一命名/角度域）。
  [AI] 关节名与 rak_arm.urdf.xacro 一致，且 = docs/arm_moveit_contract.md §1（FROZEN）
  的 j1_base 系 —— 与真机 rak_chassis.urdf.xacro 同名同域，规划结果可直接发真机。
  角度域：**指令角**（绝对 0..270°，J2 实测硬件限 0..255°）。
  轴序约定（固件 R42 app_car.h）：axis[0..5] = J1..J6，与 MoveIt joint 顺序一致。
-->
<robot name="rak">
  <!-- 车顶安装：底盘由 Nav2 管，MoveIt 本轮用 fixed（随车规划是后续工作）。
       注意：arm_base_link 挂在世界系，真实安装高度/朝向由整车 URDF 的
       base_footprint→arm_base_link 固定关节给出（待安装位姿实测后补）。 -->
  <virtual_joint name="world_to_arm" type="fixed"
                 parent_frame="world" child_link="arm_base_link"/>

  <group name="arm">
    <chain base_link="arm_base_link" tip_link="tool0"/>
  </group>

  <!-- 夹爪（第 7 路 PWM 舵机）不进规划组，由独立接口控制（ADR-0008） -->

  <group_state name="home" group="arm">
    <!-- [AI] 2026-10-15：关节值域已统一成**指令角**（与真机契约 FROZEN 同域），
         故 home 直接就是固件指令角 J1=0° J2=225° J3=270° J4=0° J5=0° J6=0°，
         不再需要 q_urdf 换算。

         [AI] 2026-10-16 订正 j3 的**刀口值**：270° 的精确值是 4.71238898038…，
         原先写 4.7123890 比它**大 1.96e-8**，即**超出 URDF 上限**。
         （同一类错在 rak_arm.urdf.xacro 的 <ros2_control> initial_value 上已经踩过 ——
           controller_manager 会判 out of limits 并每秒刷一条 ERROR。）
         这里取**向下截断**的 4.7123889，与 URDF 的 initial_value 对齐。
         ⚠️ 压线的角度值一律**向下截**，别四舍五入。
         j2 的 3.9269908（225°，精确 3.9269908169…）本来就小于真值，无需改。 -->
    <joint name="j1_base"         value="0"/>
    <joint name="j2_shoulder"     value="3.9269908"/>
    <joint name="j3_elbow"        value="4.7123889"/>
    <joint name="j4_forearm"      value="0"/>
    <joint name="j5_wrist_pitch"  value="0"/>
    <joint name="j6_wrist_roll"   value="0"/>
  </group_state>

  <disable_collisions link1="arm_base_link"    link2="shoulder_link"      reason="Adjacent"/>
  <disable_collisions link1="shoulder_link"    link2="upper_arm_link"     reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link"   link2="forearm_link"       reason="Adjacent"/>
  <disable_collisions link1="forearm_link"     link2="forearm_roll_link"  reason="Adjacent"/>
  <disable_collisions link1="forearm_roll_link" link2="wrist_pitch_link"  reason="Adjacent"/>
  <disable_collisions link1="wrist_pitch_link" link2="tool0"              reason="Adjacent"/>
  <!-- 有意不禁用：arm_base_link ↔ upper_arm_link 等非相邻对（规划期要真查碰撞） -->
</robot>
