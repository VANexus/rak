<?xml version="1.0"?>
<!-- Simulation-only semantic model; not the robot's measured geometry. -->
<robot name="rak_six_axis_sim">
  <virtual_joint name="world_to_base" type="fixed"
                 parent_frame="world" child_link="base_link"/>

  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="gripper_joint"/>
  </group>
  <end_effector name="gripper_eef" parent_link="tool0" group="gripper"/>

  <group_state name="home" group="arm">
    <joint name="base_yaw_joint" value="0"/>
    <joint name="shoulder_pitch_joint" value="0"/>
    <joint name="elbow_pitch_joint" value="0"/>
    <joint name="wrist_yaw_joint" value="0"/>
    <joint name="wrist_pitch_joint" value="0"/>
    <joint name="wrist_roll_joint" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper_joint" value="0.05"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_joint" value="0"/>
  </group_state>

  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_yaw_link" link2="wrist_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_pitch_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_link" reason="Adjacent"/>
</robot>
