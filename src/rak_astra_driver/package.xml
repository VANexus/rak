<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_astra_driver</name>
  <version>0.1.0</version>
  <description>Orbbec Astra S → ROS2 Jazzy bridge using Orbbec SDK 1.10.18 (legacy OpenNI2 path).</description>
  <maintainer email="xrak@xrak.local">xrak</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <!-- [AI] L2 组件化: 组件库 + component_container(launch 引用) -->
