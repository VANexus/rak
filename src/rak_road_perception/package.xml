<?xml version="1.0"?>
<package format="3">
  <name>rak_road_perception</name>
  <version>0.1.0</version>
  <description>Jetson TorchScript road segmentation with optional Nav2 point-cloud observations.</description>
  <maintainer email="xrak@xrak.local">xrak</maintainer>
  <license>Apache-2.0</license>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
