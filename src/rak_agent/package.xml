<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_agent</name>
  <version>0.1.0</version>
  <description>rak decision layer: System 1 (Laya) + System 2 (RAI), as a ROS 2 node</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>rak_interfaces</depend>
  <!-- ADR-0020 §5：managed 基类（引擎在 configure 加载）+ 诊断上报 -->
  <depend>rak_lifecycle</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>python3-pydantic</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
