<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_commissioning</name>
  <version>0.1.0</version>
  <description>Commissioning and teach tools: drive TUI, arm servo TUI, keyboard chassis test (ADR-0013). Not production motion interfaces.</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- [AI] 两个 TUI 共用 rak_base_driver 的 USB v2 编解码（R30/R42 协议） -->
  <depend>rclpy</depend>
  <depend>rak_base_driver</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
