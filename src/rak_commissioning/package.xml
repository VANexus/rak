<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_commissioning</name>
  <version>0.1.0</version>
  <description>Commissioning tools speaking standard ROS interfaces (ADR-0013/0016): keyboard chassis test publishes Twist, chassis/arm TUIs jog over controller topics and FollowJointTrajectory actions — never a transport. Not production motion interfaces.</description>
  <maintainer email="xrak@todo.todo">xrak</maintainer>
  <license>Apache-2.0</license>


  <depend>rclpy</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- [AI] arm_tui：只经标准 ROS 接口对话（ADR-0016 决策 2），无任何传输层依赖 -->
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- 限速单一数值来源：chassis_limits（见 chassis_key_test.py 注释） -->
  <exec_depend>rak_tool_executor</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
